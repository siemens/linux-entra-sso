{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "files": {
        "includes": ["**", "!**/updates.json"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "overrides": [
        {
            "includes": [".github/**", "**/*.md"],
            "formatter": {
                "indentWidth": 2
            }
        }
    ],
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "root": "."
    }
}
